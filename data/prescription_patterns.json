  "regex_patterns": {
    "medication": [
      "(?:Tab(?:let)?\\.?|Cap(?:sule)?\\.?|Syrup\\.?|Inj(?:ection)?\\.?)\\s*([A-Za-z][A-Za-z\\s-]+?)(?:\\s+\\d+\\s*(?:mg|g|ml|mcg))?",
      "\\b([A-Z][a-z]+(?:cillin|mycin|prazole|olol|sartan|statin|pril|dipine|azole|idine|amine|etine|azepam))\\b",
      "Rx[:\\s]+([A-Za-z][A-Za-z\\s-]+?)(?=\\s+\\d|\\s*$)",
      "^\\s*\\d+[.)\\s]+([A-Z][a-zA-Z\\s-]+?)(?:\\s+\\d+\\s*(?:mg|g|ml))"
    ],
    "dosage": [
      "(\\d+(?:\\.\\d+)?)\\s*(mg|g|ml|mcg|IU|tablets?|caps?|capsules?)"
    ],
    "frequency": [
      "(once|twice|thrice|\\d+\\s*times?)\\s*(?:a\\s*)?(?:day|daily)",
      "(every\\s*\\d+\\s*(?:hours?|hrs?))",
      "(morning|evening|night|bedtime)",
      "(OD|BD|TDS|TID|QID|QD|BID|PRN|SOS|HS)",
      "(\\d+[-\u2013]\\d+[-\u2013]\\d+)"
    ],
    "duration": [
      "(?:for\\s*)?(\\d+)\\s*(days?|weeks?|months?)"
    ]
  }
