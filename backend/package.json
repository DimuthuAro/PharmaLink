{
    "name": "pharmalink-backend",
    "version": "1.0.0",
    "description": "Pharmalink Backend - Express Microservices Architecture",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "dev:all": "node scripts/start-dev.js",
        "start:dev": "concurrently \"npm run dev:drug-interaction\" \"npm run dev:advisory\" \"npm run dev:comparator\" \"npm run dev:interpreter\"",
        "dev:stack": "concurrently \"npm run dev\" \"npm run dev:drug-interaction\"",
        "dev:drug-interaction": "cd microservices/drug_interaction_microservice && npm run dev",
        "dev:advisory": "cd microservices/personalized_advisory_microservice && npm run dev",
        "dev:comparator": "cd microservices/crossbrand_comparator_microservice && npm run dev",
        "dev:interpreter": "cd microservices/prescription_interpreter_microservice && npm run dev",
        "install:all": "npm install && npm run install:microservices",
        "install:microservices": "cd microservices/drug_interaction_microservice && npm install && cd ../personalized_advisory_microservice && npm install && cd ../crossbrand_comparator_microservice && npm install && cd ../prescription_interpreter_microservice && npm install",
        "setup": "npm run install:all && npm run setup:infrastructure",
        "setup:infrastructure": "node scripts/setup-infrastructure.js",
        "test": "jest",
        "test:integration": "jest --config=jest.integration.config.js"
    },
    "keywords": [
        "pharmalink",
        "express",
        "microservices",
        "healthcare",
        "pharmacy"
    ],
    "author": "Pharmalink Team",
    "license": "MIT",
    "dependencies": {
        "express": "^4.18.2",
        "cors": "^2.8.5",
        "helmet": "^7.1.0",
        "morgan": "^1.10.0",
        "dotenv": "^16.3.1",
        "mongoose": "^7.6.3",
        "redis": "^4.6.10",
        "amqplib": "^0.10.3",
        "multer": "^1.4.5-lts.1",
        "express-rate-limit": "^7.1.5",
        "compression": "^1.7.4",
        "winston": "^3.11.0",
        "joi": "^17.11.0",
        "jsonwebtoken": "^9.0.2",
        "bcryptjs": "^2.4.3",
        "http-proxy-middleware": "^2.0.6"
    },
    "devDependencies": {
        "nodemon": "^3.0.1",
        "concurrently": "^8.2.2",
        "jest": "^29.7.0",
        "supertest": "^6.3.3",
        "eslint": "^8.52.0",
        "prettier": "^3.0.3"
    },
    "engines": {
        "node": ">=16.0.0",
        "npm": ">=8.0.0"
    }
}